storage = 0


# Storage grid definition:
# 10 (width) x 9 (height) matrix, indexed at (row=x, col=y) = (0..8, 0..9)
# Board squares: x = 1..8, y = 1..8
# Storage:
#   - primary: row 0, cols 1..8  (the "0 row" above the board)
#   - extra:   col 0 and col 9, rows 1..8
#   - corners: (0,0) and (0,9)

_storage_squares = []

# 1) Row 0 above the board: (x=0, y=1..8) → used FIRST
for y in range(1, 9):
    _storage_squares.append((0, y))

# 2) Left edge of the board: (x=1..8, y=0)
for x in range(1, 9):
    _storage_squares.append((x, 0))

# 3) Right edge of the board: (x=1..8, y=9)
for x in range(1, 9):
    _storage_squares.append((x, 9))

# 4) Corners on row 0: (0,0) and (0,9)
_storage_squares.append((0, 0))
_storage_squares.append((0, 9))

# Now _storage_squares has 26 unique positions, each can store 2 pieces → 52 slots.


def motorController(distance, axis):

    if distance < 0: #if distance is negative, set direction to HIGH 
        m1dir.off()
        m2dir.off()
        dist = -distance
    else:
        dist = distance
        m1dir.on()
        m2dir.on()

    #calculate steps based on factors
    steps = int(((dist * squareSize) / rotationLength) * stepsPerRotation)

    if axis == 'x': #for x axis, control two x axis motors
        for i in range(steps):
            m1step.on()
            time.sleep(motorDelay * .00005)
            m1step.off()
            time.sleep(motorDelay * .00005)

    else: # for y axis, control the y axis motor (m2)
        for i in range(steps):
            m2step.on()
            time.sleep(motorDelay * .00005)
            m2step.off()
            time.sleep(motorDelay * .00005)

    #ensure motor direction is set to LOW
    m1dir.off()
    m2dir.off()

def locationOnEdge(x1,y1,x2,y2):
    #goes from 0,0 to x1,y1
    #grabs piece then goes to x2,y2
    #then goes back to 0,0
    #all along the edges
    motorController(.5,'x') # to edge
    motorController(.5,'y') # to edge
    motorController(x1-1,'x')
    motorController(y1-1,'y')
    motorController(.5,'x') # to center
    motorController(.5,'y') # to center
    mag.on()
    time.sleep(.5)
    motorController(-.5,'x') # back to edge
    motorController(-.5,'y') # back to edge
    motorController(x2-x1, 'x')
    motorController(y2-y1, 'y')
    motorController(.5,'x') # to center
    motorController(.5,'y') # to center
    mag.off()
    motorController((-x2),'x') # back to edge
    motorController((-y2),'y') # back to edge


def moveCapturedToStorage(x_victim, y_victim, store_x, store_y, slot_pos):
    """
    Move from origin to the victim square (x_victim,y_victim), pick up the piece,
    then travel along the edge grid to the storage coordinate (store_x,store_y),
    drop it, and return to origin.

    Coords:
      - x_victim, y_victim: 1..8 (board)
      - store_x: 0..8 (row)
      - store_y: 0..9 (col)
      - slot_pos:
          0 → edge
          1 → center-ish position inward from the edge
    """

    # 1) Go from (0,0) to board edges
    motorController(.5, 'x')  # down to board edge
    motorController(.5, 'y')  # right to board edge

    # 2) Slide along edges to victim
    motorController(x_victim - 1, 'x')  # rows
    motorController(y_victim - 1, 'y')  # cols

    # 3) Edge → center of victim square
    motorController(.5, 'x')
    motorController(.5, 'y')

    # 4) Grab the piece
    mag.on()
    time.sleep(.5)

    # 5) Center → edge again
    motorController(-.5, 'x')
    motorController(-.5, 'y')

    # 6) Move along edges to storage square
    motorController(store_x - x_victim, 'x')
    motorController(store_y - y_victim, 'y')

    # 7) Drop piece
    if slot_pos == 0:
        # Edge slot: just drop
        mag.off()
    else:
        # Center slot: move 0.5 inward from edge, then back.
        # We must NEVER step negative from 0 or beyond 9.
        if store_x == 0 and 1 <= store_y <= 8:
            # Row 0 above board, interior is +x (down)
            motorController(.5, 'x')
            mag.off()
            motorController(-.5, 'x')

        elif 1 <= store_x <= 8 and store_y == 0:
            # Left of board, interior is +y (right)
            motorController(.5, 'y')
            mag.off()
            motorController(-.5, 'y')

        elif 1 <= store_x <= 8 and store_y == 9:
            # Right of board, interior is -y (left)
            motorController(-.5, 'y')
            mag.off()
            motorController(.5, 'y')

        elif store_x == 0 and store_y == 0:
            # Top-left corner: go down (+x) a bit
            motorController(.5, 'x')
            mag.off()
            motorController(-.5, 'x')

        elif store_x == 0 and store_y == 9:
            # Top-right corner: also go down (+x) a bit
            motorController(.5, 'x')
            mag.off()
            motorController(-.5, 'x')

        else:
            # Fallback: unknown edge, just drop at edge
            mag.off()

    # 8) Return to origin along edges
    motorController(-store_x, 'x')
    motorController(-store_y, 'y')




